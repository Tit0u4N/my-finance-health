{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["biome.json", "packages/typescript-config/*.json"],
  "globalEnv": [],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": [],
      "env": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "vitest.config.ts", "package.json"],
      "outputs": [],
      "env": []
    },
    "test:e2e": {
      "cache": false,
      "env": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"],
      "env": []
    }
  }
}
