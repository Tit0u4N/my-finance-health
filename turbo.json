{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["biome.json", "packages/typescript-config/*.json"],
  "globalEnv": [],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tsconfig.json", "package.json", "vite.config.ts", "vitest.config.ts", "app.json"],
      "outputs": [],
      "env": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "vitest.config.ts",
        "vitest.config.mts",
        "vitest.setup.ts",
        "babel.config.js",
        "package.json"
      ],
      "outputs": [],
      "env": []
    },
    "test:e2e": {
      "cache": false,
      "env": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        ".env*",
        "index.html",
        "postcss.config.js",
        "vite.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "bundle": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "modules/**",
        "assets/**",
        ".env*",
        "index.js",
        "app.json",
        "babel.config.js",
        "metro.config.js",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/**"],
      "env": ["EXPO_PUBLIC_*"]
    }
  }
}
