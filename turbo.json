{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["biome.json", "packages/typescript-config/*.json"],
  "globalEnv": [],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tsconfig.json", "package.json", "vite.config.ts", "vitest.config.ts", "app.json"],
      "outputs": [],
      "env": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "vitest.config.ts", "vitest.setup.ts", "jest.config.js", "babel.config.js", "package.json"],
      "outputs": [],
      "env": []
    },
    "test:e2e": {
      "cache": false,
      "env": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": []
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "index.html", "postcss.config.js", "vite.config.ts", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"],
      "env": []
    }
  }
}
