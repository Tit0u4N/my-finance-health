{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/dist",
      "!!**/build",
      "!!**/out",
      "!!**/.next",
      "!!**/node_modules",
      "!!**/.turbo",
      "!!**/.biome",
      "!!**/components/ui",
      "!!**/.expo",
      "!!**/next-env.d.ts",
      "!!**/bun.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf",
    "attributePosition": "auto"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noSvgWithoutTitle": "warn",
        "useMediaCaption": "warn",
        "useKeyWithClickEvents": "off",
        "useKeyWithMouseEvents": "off",
        "noLabelWithoutControl": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 25
          }
        },
        "noForEach": "off",
        "noVoid": "off",
        "useSimplifiedLogicExpression": "warn"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "warn",
        "noUndeclaredVariables": "error",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error",
        "noUndeclaredDependencies": "error"
      },
      "performance": {
        "noAccumulatingSpread": "warn",
        "noDelete": "warn",
        "noBarrelFile": "off"
      },
      "security": {
        "noGlobalEval": "error",
        "noDangerouslySetInnerHtml": "warn"
      },
      "style": {
        "useNodejsImportProtocol": "off",
        "useConst": "error",
        "useTemplate": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noParameterAssign": "warn",
        "noNegationElse": "warn",
        "useBlockStatements": "error",
        "useSelfClosingElements": "error",
        "useShorthandFunctionType": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useFilenamingConvention": {
          "level": "warn",
          "options": {
            "requireAscii": true,
            "filenameCases": ["camelCase", "kebab-case", "PascalCase"]
          }
        },
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "variable"
                },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "function"
                },
                "formats": ["camelCase", "PascalCase"]
              },
              {
                "selector": {
                  "kind": "typeLike"
                },
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "enumMember"
                },
                "formats": ["PascalCase", "CONSTANT_CASE"]
              }
            ]
          }
        }
      },
      "suspicious": {
        "noDebugger": "error",
        "noConsole": "warn",
        "noDoubleEquals": "error",
        "noExplicitAny": "warn",
        "noImplicitAnyLet": "error",
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "error",
        "noConfusingVoidType": "error",
        "noDuplicateTestHooks": "error",
        "noExportsInTest": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "warn",
        "useAwait": "error",
        "noShadow": "warn"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "attributes": ["classList", "class", "className"],
            "functions": ["clsx", "cva", "tw", "cn", "twMerge", "twJoin"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "semicolons": "always",
      "trailingCommas": "all",
      "quoteProperties": "asNeeded"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none",
      "indentStyle": "space",
      "indentWidth": 2
    },
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    }
  },
  "css": {
    "linter": {
      "enabled": true
    },
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**", "**/cli/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@repo/data",
                      "@repo/data/**",
                      "@repo/i18n",
                      "@repo/i18n/**",
                      "@repo/platform-web",
                      "@repo/platform-web/**",
                      "@repo/platform-tauri",
                      "@repo/platform-tauri/**",
                      "@repo/platform-expo",
                      "@repo/platform-expo/**",
                      "@repo/app-core",
                      "@repo/app-core/**",
                      "@repo/ui",
                      "@repo/ui/**",
                      "@repo/routes",
                      "@repo/routes/**",
                      "@repo/router",
                      "@repo/router/**"
                    ],
                    "message": "Forbidden by the dependency matrix of docs/start-roadmap.md §6. Allowed here: @repo/platform, @repo/design-tokens."
                  },
                  {
                    "group": ["react", "react/**", "react-dom", "react-dom/**"],
                    "message": "Level 0 and level 1 packages are pure TypeScript: no React (docs/start-roadmap.md §5)."
                  },
                  {
                    "group": ["react-native", "react-native/**", "react-native-*", "react-native-*/**"],
                    "message": "react-native is installed only in apps/mobile. No shared package may import it (docs/start-roadmap.md §7)."
                  },
                  {
                    "group": ["@tauri-apps/*", "@tauri-apps/*/**", "expo", "expo/**", "expo-*", "expo-*/**"],
                    "message": "Native imports are fenced: expo-* only in @repo/platform-expo and apps/mobile, @tauri-apps/* only in @repo/platform-tauri and apps/desktop (docs/start-roadmap.md §6, structural ban 3)."
                  }
                ]
              }
            }
          }
        }
      }
    },
