{
  "expo": {
    "name": "my finance health",
    "slug": "my-finance-health",
    "version": "0.0.0",
    "scheme": "myfinancehealth",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.myfinancehealth.mobile"
    },
    "android": {
      "package": "app.myfinancehealth.mobile"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    }
  }
}
