{
  "expo": {
    "name": "my finance health",
    "slug": "my-finance-health",
    "version": "1.0.0",
    "scheme": "myfinancehealth",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.myfinancehealth.mobile",
      "appleTeamId": "35V4HB4GBP",
      "entitlements": {
        "com.apple.developer.icloud-container-identifiers": ["iCloud.app.myfinancehealth.mobile"],
        "com.apple.developer.icloud-services": ["CloudDocuments"],
        "com.apple.developer.ubiquity-container-identifiers": ["iCloud.app.myfinancehealth.mobile"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUbiquitousContainers": {
          "iCloud.app.myfinancehealth.mobile": {
            "NSUbiquitousContainerIsDocumentScopePublic": true,
            "NSUbiquitousContainerName": "my finance health",
            "NSUbiquitousContainerSupportedFolderLevels": "Any"
          }
        }
      }
    },
    "android": {
      "package": "app.myfinancehealth.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#635BFF"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ],
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to unlock your workspace."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to unlock your workspace."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6d5b6ad8-e1db-46c5-97b4-df7a3813eafd",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "6d5b6ad8-e1db-46c5-97b4-df7a3813eafd"
      }
    },
    "owner": "titoucharless-team"
  }
}
