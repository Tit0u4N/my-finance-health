# Storage backend the app bootstraps against.
# inMemory - RAM-only mock workspace, seeded with fixture data. Nothing persists across
#            restarts. Works in Expo Go-less dev builds and in tests.
# classic  - real workspace bootstrap: an encrypted SQLite workspace stored on the device (app
#            sandbox, visible in the iOS Files app), created / imported / unlocked through a
#            bootstrap screen, mirroring apps/desktop/src/bootstrap/. Needs a development build
#            (`bun run prebuild`, then `bun run ios` / `bun run android`): SQLCipher is compiled
#            in through expo-sqlite's config plugin, so the generic Expo Go client cannot run it.
#            See apps/mobile/src/root/LocalAppRoot.tsx.
#
# Expo only inlines env vars prefixed EXPO_PUBLIC_ (see Expo's docs on environment variables).
EXPO_PUBLIC_STORAGE_MODE=inMemory
