# Storage backend the app bootstraps against.
# inMemory - RAM-only mock workspace, seeded with fixture data. Nothing persists across
#            restarts. The only mode wired up so far — see apps/mobile/src/root/AppRoot.tsx.
# classic  - real workspace bootstrap: local encrypted SQLite, chosen/created via a bootstrap
#            screen, mirroring apps/desktop/src/bootstrap/. Needs @repo/platform-expo's real
#            SQLite/file-system adapter, which is still a placeholder — not usable yet.
#
# Expo only inlines env vars prefixed EXPO_PUBLIC_ (see Expo's docs on environment variables).
EXPO_PUBLIC_STORAGE_MODE=inMemory
