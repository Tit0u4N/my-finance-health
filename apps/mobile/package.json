{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@repo/design-tokens": "workspace:*",
    "expo": "~57.0.17",
    "expo-constants": "~57.0.15",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "catalog:native",
    "react-native": "catalog:native",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "catalog:native",
    "babel-preset-expo": "~57.0.9",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.2.0",
    "typescript": "^5.9.3"
  },
  "expo": {
    "install": {
      "//": "TypeScript is pinned once for the whole monorepo; SDK 57 would pull a major on this app alone.",
      "exclude": [
        "typescript"
      ]
    }
  }
