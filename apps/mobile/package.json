{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "bundle": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@formatjs/intl-relativetimeformat": "^12.3.15",
    "@repo/app-core": "workspace:*",
    "@repo/data": "workspace:*",
    "@repo/design-tokens": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/platform": "workspace:*",
    "@repo/platform-expo": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "buffer": "^6.0.3",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "ky": "^2.1.0",
    "lucide-react-native": "^0.545.0",
    "react": "catalog:native",
    "react-native": "catalog:native",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.8",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "catalog:native",
    "babel-preset-expo": "~58.0.25",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-native": "^0.13.0"
  },
  "expo": {
    "install": {
      "//": "TypeScript is pinned once for the whole monorepo on 7.x; SDK 57 would pull it back down to 5.x on this app alone.",
      "exclude": [
        "typescript"
      ]
    }
  }
}
