# Storage backend the app bootstraps against.
# inMemory - RAM-only mock workspace, seeded with fixture data. Nothing persists across
#            restarts. Used for local dev and tests.
# classic  - real workspace bootstrap: local encrypted SQLite, chosen/created via the bootstrap
#            screen (apps/desktop/src/bootstrap/). Needs a real Tauri runtime — `bun tauri dev`,
#            not the plain Vite dev server.
VITE_STORAGE_MODE=inMemory
