# Storage backend the app bootstraps against.
# inMemory - RAM-only mock workspace, seeded with fixture data. Nothing persists across
#            restarts. Used for local dev and tests until the real bootstrap sequence lands.
# classic  - real workspace bootstrap (local SQLite or remote API, chosen at workspace
#            creation). Not wired up yet — selecting it currently throws.
VITE_STORAGE_MODE=inMemory
