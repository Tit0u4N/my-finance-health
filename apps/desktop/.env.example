# Storage backend the app bootstraps against. Default (unset) is `classic`.
# classic  - real workspace bootstrap: local encrypted SQLite, chosen/created via the bootstrap
#            screen (apps/desktop/src/bootstrap/). Needs a real Tauri runtime — `bun tauri dev`,
#            not the plain Vite dev server.
# inMemory - opt-in demo: RAM-only mock workspace, seeded with fixture data. Nothing persists
#            across restarts. For tests and the plain Vite dev server only.
VITE_STORAGE_MODE=classic
